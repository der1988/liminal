{
  "name": "punto-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/world.test.ts tests/births.test.ts tests/memory.test.ts tests/persistence.test.ts",
    "test:generations": "tsx --test tests/generations.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "7.1.12"
  }
}
